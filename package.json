{
  "name": "@bradygaster/create-squad",
  "version": "0.5.4",
  "description": "Add an AI agent team to any project",
  "bin": {
    "create-squad": "./index.js"
  },
  "files": [
    "index.js",
    ".github/agents/squad.agent.md",
    "templates/**/*",
    "CHANGELOG.md"
  ],
  "scripts": {
