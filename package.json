    "supervisor": "tsx src/supervisor/index.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "copilot",
    "squad",
    "team"
  ],
  "author": "bradygaster",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bradygaster/squad"
  },
  "dependencies": {
    "ioredis": "^5.10.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
